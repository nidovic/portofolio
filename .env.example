# Copy to .env. Replace placeholders with a newly rotated Atlas database user.
# Never commit .env or expose its values in screenshots.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_DB_NAME=Portfolio
MONGODB_URI=mongodb+srv://<username>:<new-password>@<cluster-host>/Portfolio?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_NAME=Portfolio Administrator
ADMIN_PASSWORD=