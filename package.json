{
  "name": "myportfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "author": "Blessing Ajiboye",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "docx": "^9.10.0",
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --prefix client\" \"nodemon server.js\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "nodemon server.js",
    "start": "node server.js",
    "build": "npm run build --prefix client",
    "build:server": "node scripts/build-server.js",
    "lint": "npm run lint --prefix client && npm run lint:server",
    "lint:server": "node --check server.js && find server config scripts -name '*.js' -type f -exec node --check {} +",
    "seed:portfolio": "node scripts/seed-portfolio.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test:api": "node scripts/test-api.js",
    "evidence": "node scripts/generate-evidence.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.2"
  }
}
